<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Square crop of the site's space background, behind the site favicon. -->
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground>
        <!-- 84dp logo: the outer ring may clip, keeping the Gundam face large. -->
        <inset android:inset="12dp">
            <bitmap android:src="@drawable/cardbattlelab" android:filter="true" />
        </inset>
    </foreground>
</adaptive-icon>
